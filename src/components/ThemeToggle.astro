---
// Modern Sun/Moon Theme Toggle with LocalStorage persistence
---

<button
  type="button"
  aria-label="Toggle dark mode"
  class="theme-toggle-btn relative p-2 rounded-lg text-content-secondary hover:text-content-primary dark:text-zinc-400 dark:hover:text-white bg-surface-card/80 dark:bg-zinc-800/80 border border-border-subtle dark:border-zinc-700/60 shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-brand-amber/50"
>
  <!-- Sun Icon (Visible in Dark Mode) -->
  <svg
    class="w-4 h-4 hidden dark:block transition-transform duration-300 rotate-0 hover:rotate-45 text-amber-400"
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <path
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      fill-rule="evenodd"
      clip-rule="evenodd"
    />
  </svg>

  <!-- Moon Icon (Visible in Light Mode) -->
  <svg
    class="w-4 h-4 block dark:hidden transition-transform duration-300 hover:-rotate-12 text-zinc-700"
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <path
      d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    />
  </svg>
</button>

<script is:inline>
  function setupThemeToggles() {
    const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
    toggleBtns.forEach((btn) => {
      // Remove old listener if any
      btn.onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };
    });
  }

  // Setup on load & swap
  setupThemeToggles();
  document.addEventListener('astro:after-swap', setupThemeToggles);
</script>
