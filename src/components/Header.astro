---
// Minimal editorial founder header
import ThemeToggle from './ThemeToggle.astro';
---

<header class="absolute top-0 left-0 right-0 z-40 w-full transition-all duration-300 border-b border-border-subtle/70 dark:border-white/[0.08] bg-surface-ground/80 dark:bg-[#09090C]/80 backdrop-blur-xl shadow-sm dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.5)]" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo / Wordmark: Morshadun Nur (Focus on Nur) -->
      <div class="flex items-center">
        <a href="/" class="group flex items-center py-1">
          <span class="text-lg sm:text-xl font-display font-medium tracking-tight text-content-primary dark:text-white">
            Morshadun <span class="font-extrabold text-content-primary dark:text-white underline decoration-brand-amber decoration-[2.5px] underline-offset-[5px] group-hover:text-brand-amber transition-colors">Nur</span>
          </span>
        </a>
      </div>
      
      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8">
        <a href="#work" class="text-sm font-medium text-content-secondary dark:text-zinc-400 hover:text-content-primary dark:hover:text-white transition-colors">
          Work
        </a>
        <a href="#products" class="text-sm font-medium text-content-secondary dark:text-zinc-400 hover:text-content-primary dark:hover:text-white transition-colors">
          Products
        </a>
        <a href="#about" class="text-sm font-medium text-content-secondary dark:text-zinc-400 hover:text-content-primary dark:hover:text-white transition-colors">
          About
        </a>
        <a href="#expertise" class="text-sm font-medium text-content-secondary dark:text-zinc-400 hover:text-content-primary dark:hover:text-white transition-colors">
          Expertise
        </a>
        <a href="#writing" class="text-sm font-medium text-content-secondary dark:text-zinc-400 hover:text-content-primary dark:hover:text-white transition-colors">
          Writing
        </a>
        <a href="#contact" class="text-sm font-medium text-content-secondary dark:text-zinc-400 hover:text-content-primary dark:hover:text-white transition-colors">
          Contact
        </a>
      </nav>
      
      <!-- Right CTA & Theme Toggle -->
      <div class="hidden md:flex items-center space-x-4">
        <ThemeToggle />
        <a 
          href="#contact" 
          class="inline-flex items-center px-4 py-2.5 rounded text-xs sm:text-sm font-semibold text-white bg-content-primary hover:bg-black dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100 transition-all shadow-sm hover:shadow active:scale-[0.99]"
        >
          <span>Let's Work Together</span>
          <span class="ml-1.5 transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>

      <!-- Mobile Menu Button & Mobile Theme Toggle -->
      <div class="flex items-center space-x-2 md:hidden">
        <ThemeToggle />
        <button 
          id="open-mobile-nav" 
          class="inline-flex items-center justify-center p-2 rounded text-content-primary dark:text-zinc-300 hover:bg-surface-muted dark:hover:bg-zinc-800 focus:outline-none"
          aria-label="Open Navigation Menu"
        >
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
      
    </div>
  </div>
</header>

<!-- Spacer to prevent hero overlap -->
<div class="h-20"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      if (scrollTop > 20) {
        header?.classList.add('shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)]', 'bg-surface-ground/95');
      } else {
        header?.classList.remove('shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)]', 'bg-surface-ground/95');
      }
    });
  });
</script>