---
// Founder-led editorial footer
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-dark text-content-light border-t border-border-dark py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-border-dark">
      
      <!-- Brand statement -->
      <div class="md:col-span-6 space-y-4">
        <span class="text-2xl font-display font-medium text-white tracking-tight">
          Morshadun <span class="font-extrabold underline decoration-brand-amber decoration-[2.5px] underline-offset-[5px]">Nur</span>
        </span>
        <p class="text-sm font-mono text-content-light-muted">
          Founder · Product Engineer · Shopify · SaaS · AI
        </p>
        <p class="text-sm text-content-light-muted max-w-md leading-relaxed">
          Building high-converting Shopify stores, SaaS applications, custom software platforms, and AI automation systems that help businesses scale.
        </p>
      </div>

      <!-- Companies & Products -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono font-semibold text-brand-amber tracking-widest uppercase">
          Companies & Products
        </h3>
        <ul class="space-y-2 text-sm text-content-light-muted">
          <li>
            <a href="https://qbytesoft.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>QbyteSoft</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://storesforge.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>StoresForge</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://showform.app" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>ShowForm.app</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://apps.shopify.com/spotmetal-pricing-buyback" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>SpotMetal</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://autogaragepro.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>AutoGaragePro</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Connect & Inquiries -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono font-semibold text-brand-amber tracking-widest uppercase">
          Connect
        </h3>
        <ul class="space-y-2 text-sm text-content-light-muted">
          <li>
            <a href="https://www.upwork.com/freelancers/morshadunnur" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span class="text-emerald-400 font-medium">Upwork (Top Rated Plus)</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/morshadunnur/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>LinkedIn</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/morshadunnur" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>GitHub</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="mailto:me@morshadunnur.me" class="hover:text-white transition-colors flex items-center group">
              <span>Email (me@morshadunnur.me)</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
          <li>
            <a href="https://x.com/morshadun" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center group">
              <span>X (Twitter)</span>
              <span class="ml-1 text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-border-dark flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-content-light-muted gap-4">
      <p>© {currentYear} Morshadun Nur. All rights reserved.</p>
      <div class="flex items-center space-x-6">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>