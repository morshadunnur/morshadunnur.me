---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile.png';
import project1Image from '../assets/images/project-1.jpg';
import project2Image from '../assets/images/project-2.jpg';
import project3Image from '../assets/images/project-3.jpg';
import project4Image from '../assets/images/project-4.jpg';
---

<Layout 
  title="Morshadun Nur — Founder, Product Engineer, Shopify & AI Builder"
  description="Building Shopify, SaaS & AI products that help businesses scale. Founder of QbyteSoft & StoresForge. Creator of ShowForm.app."
>

  <!-- 1. HERO SECTION (WITH VIDEO CLIENT FEEDBACK ON RIGHT) -->
  <section class="relative pt-28 sm:pt-32 md:pt-36 lg:pt-40 pb-16 md:pb-24 px-4 sm:px-6 lg:px-8 border-b border-border-subtle bg-surface-ground overflow-hidden">
    <!-- Subtle architectural background grid line -->
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>
    
    <!-- Ambient glowing light accents (Brighten Studios aesthetic) -->
    <div class="absolute -top-32 left-1/4 -z-10 w-[500px] h-[500px] bg-brand-amber/10 dark:bg-amber-500/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-20 -z-10 w-[450px] h-[450px] bg-blue-500/5 dark:bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
        
        <!-- Left: Hero Headline & Copy -->
        <div class="lg:col-span-7 space-y-7">
          <!-- Eyebrow Pill -->
          <div class="hero-eyebrow inline-flex items-center space-x-2.5 px-4 py-1.5 rounded-full bg-surface-card border border-border-subtle shadow-sm">
            <span class="w-2 h-2 rounded-full bg-brand-emerald animate-pulse"></span>
            <span class="text-xs font-mono font-semibold tracking-wider text-content-secondary uppercase">
              FOUNDER · PRODUCT ENGINEER · SHOPIFY · AI
            </span>
          </div>

          <!-- Main Headline -->
          <h1 class="hero-title text-3xl sm:text-4xl md:text-5xl lg:text-[46px] xl:text-[52px] font-display font-extrabold text-content-primary tracking-tight leading-[1.18] sm:leading-[1.15] break-words">
            Building Shopify, SaaS & AI products that help businesses scale.
          </h1>

          <!-- Supporting Copy -->
          <p class="hero-copy text-base sm:text-lg text-content-secondary leading-relaxed max-w-2xl font-sans">
            I’m <strong class="text-content-primary font-semibold">Morshadun Nur</strong> — founder, product engineer, and builder behind <span class="text-content-primary font-medium">QbyteSoft</span>, <span class="text-content-primary font-medium">StoresForge</span>, and several software products. I help businesses turn complex problems into scalable digital products, e-commerce experiences, and automation systems.
          </p>

          <!-- Action Buttons -->
          <div class="hero-ctas flex flex-wrap items-center gap-3.5 pt-2">
            <a 
              href="https://www.upwork.com/freelancers/morshadunnur" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center px-6 py-3.5 rounded font-sans text-sm font-bold text-white bg-content-primary hover:bg-black transition-all shadow-md hover:shadow-lg active:scale-[0.99] group"
            >
              <span>View My Work</span>
              <span class="ml-2 text-xs opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">↗</span>
            </a>
            <a 
              href="#contact" 
              class="inline-flex items-center px-6 py-3.5 rounded font-sans text-sm font-semibold text-content-primary bg-surface-card border border-border-muted hover:border-content-primary hover:bg-surface-muted transition-all active:scale-[0.99]"
            >
              <span>Let's Talk</span>
              <span class="ml-2 text-xs text-content-muted">↗</span>
            </a>
          </div>

          <!-- Credibility Subtext -->
          <div class="hero-creds pt-4 border-t border-border-subtle/80 flex flex-wrap items-center gap-y-2 gap-x-3 text-xs font-mono text-content-muted">
            <span>10+ years building software</span>
            <span class="text-border-muted">•</span>
            <span>Shopify</span>
            <span class="text-border-muted">•</span>
            <span>SaaS</span>
            <span class="text-border-muted">•</span>
            <span>AI</span>
            <span class="text-border-muted">•</span>
            <span>Automation</span>
          </div>
        </div>

        <!-- Right: Video Client Feedback Card -->
        <div class="hero-video-card lg:col-span-5">
          <div class="p-4 sm:p-5 rounded-2xl bg-surface-card border border-border-subtle shadow-xl space-y-4">
            
            <!-- Video Header Badge -->
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-1 text-brand-amber font-bold text-xs sm:text-sm">
                <span>★★★★★</span>
                <span class="ml-1 font-mono text-[11px] text-content-secondary uppercase tracking-wider">CLIENT FEEDBACK</span>
              </div>
              <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-emerald-50 text-emerald-700 border border-emerald-200">
                100% SUCCESS
              </span>
            </div>

            <!-- Responsive Video Frame -->
            <div class="aspect-video w-full rounded-xl overflow-hidden shadow-inner bg-black border border-border-subtle">
              <iframe 
                class="w-full h-full"
                src="https://www.youtube-nocookie.com/embed/gF63dOD1K4Y?rel=0" 
                title="Client Video Testimonial for Morshadun Nur" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen
              ></iframe>
            </div>

            <!-- Quote & Upwork Link -->
            <div class="pt-1">
              <p class="text-xs sm:text-sm font-display font-bold text-content-primary leading-snug">
                "Delivered beyond expectations — a true technical partner."
              </p>
              <div class="mt-2 flex items-center justify-between text-[11px] text-content-muted font-mono pt-2 border-t border-border-subtle">
                <span>Top Rated Plus Shopify Developer</span>
                <a 
                  href="https://www.upwork.com/freelancers/morshadunnur" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="font-bold text-[#14A800] hover:underline"
                >
                  Upwork ↗
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. TRUST / POSITIONING STRIP -->
  <section class="trust-strip border-b border-border-subtle bg-surface-muted py-5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-y-3 gap-x-6 text-xs sm:text-sm font-display font-semibold tracking-wide text-content-primary">
      <div class="trust-item flex items-center space-x-2.5">
        <svg class="w-4 h-4 text-brand-amber flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>10+ Years Experience</span>
      </div>
      <div class="hidden sm:block text-border-muted font-light">/</div>
      <div class="trust-item flex items-center space-x-2.5">
        <svg class="w-4 h-4 text-brand-amber flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span>Shopify Specialist</span>
      </div>
      <div class="hidden sm:block text-border-muted font-light">/</div>
      <div class="trust-item flex items-center space-x-2.5">
        <svg class="w-4 h-4 text-brand-amber flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>SaaS Product Builder</span>
      </div>
      <div class="hidden sm:block text-border-muted font-light">/</div>
      <div class="trust-item flex items-center space-x-2.5">
        <svg class="w-4 h-4 text-brand-amber flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>AI & Automation</span>
      </div>
      <div class="hidden sm:block text-border-muted font-light">/</div>
      <div class="trust-item flex items-center space-x-2.5">
        <svg class="w-4 h-4 text-brand-amber flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        <span>Founder</span>
      </div>
    </div>
  </section>

  <!-- 4. UPWORK TOP RATED PLUS HIRE ME SECTION -->
  <section class="py-14 md:py-20 px-4 sm:px-6 lg:px-8 bg-surface-muted border-b border-border-subtle">
    <div class="max-w-6xl mx-auto">
      <div class="p-8 sm:p-12 rounded-2xl bg-surface-card border border-border-subtle shadow-sm flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <!-- Left details -->
        <div class="space-y-4 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-pink-50 text-pink-700 border border-pink-200 flex items-center">
              <span class="mr-1">★</span> Top Rated Plus
            </span>
            <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-blue-50 text-blue-700 border border-blue-200">
              100% Job Success
            </span>
            <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-surface-muted text-content-primary border border-border-subtle">
              Verified Shopify Specialist
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-display font-bold text-content-primary tracking-tight">
            Need a Top Rated Plus Shopify & SaaS Engineer?
          </h3>

          <p class="text-sm sm:text-base text-content-secondary leading-relaxed">
            Whether you prefer working directly or contracting securely via Upwork Enterprise/Escrow, I offer flexible engagement models for startups, agencies, and e-commerce brands.
          </p>
        </div>

        <!-- Right CTAs -->
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto flex-shrink-0">
          <a 
            href="https://www.upwork.com/freelancers/morshadunnur" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center px-6 py-3.5 rounded font-display text-sm font-bold text-white bg-[#14A800] hover:bg-[#118f00] transition-all shadow-md group text-center"
          >
            <span>Hire on Upwork</span>
            <span class="ml-1.5 text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
          </a>
          <a 
            href="#contact" 
            class="inline-flex items-center justify-center px-6 py-3.5 rounded font-display text-sm font-semibold text-content-primary bg-surface-muted border border-border-muted hover:border-content-primary transition-all text-center"
          >
            <span>Direct Project Inquiry →</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. SELECTED WORK (FEATURED WORK) -->
  <section id="work" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-surface-card border-b border-border-subtle scroll-mt-20">
    <div class="max-w-6xl mx-auto">
      
      <!-- Section Header -->
      <div class="gsap-section-header mb-16 md:mb-20">
        <span class="text-xs font-mono font-bold tracking-widest text-brand-amber uppercase block mb-3">
          SELECTED WORK
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-content-primary tracking-tight">
          Products and platforms I've built to solve real business problems.
        </h2>
      </div>

      <!-- Project List -->
      <div class="space-y-12 md:space-y-16">
        
        <!-- 01 — StoresForge -->
        <article class="gsap-project-card p-8 sm:p-10 md:p-12 rounded-xl bg-surface-ground border border-border-subtle hover:border-content-muted transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group">
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center space-x-3">
              <span class="text-base font-display font-extrabold text-brand-amber">01</span>
              <span class="text-xs font-mono font-semibold tracking-wider text-content-muted uppercase">
                SHOPIFY · E-COMMERCE · AGENCY
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-display font-bold text-content-primary tracking-tight">
              Shopify experiences built to convert.
            </h3>
            <p class="text-base text-content-secondary leading-relaxed">
              Premium Shopify development for ambitious e-commerce brands — from custom storefronts and Shopify Plus implementations to apps, performance optimization, CRO, and automation.
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              {['Custom Shopify Apps', 'Shopify Plus', 'Theme Development', 'Headless Commerce', 'CRO', 'AI Automation'].map(tag => (
                <span class="px-3 py-1 text-xs font-mono font-medium rounded bg-surface-card border border-border-subtle text-content-primary">
                  {tag}
                </span>
              ))}
            </div>
            <div class="pt-2">
              <a 
                href="https://storesforge.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center text-sm font-display font-bold text-content-primary group-hover:text-brand-amber transition-colors"
              >
                <span>Explore StoresForge</span>
                <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span>
              </a>
            </div>
          </div>
          <div class="lg:col-span-5">
            <div class="aspect-[16/10] rounded-lg overflow-hidden border border-border-subtle bg-surface-dark relative shadow-inner">
              <Image 
                src={project1Image} 
                alt="StoresForge Shopify E-commerce Platform" 
                class="w-full h-full object-cover object-top filter grayscale group-hover:grayscale-0 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-6 flex flex-col justify-end">
                <span class="text-xs font-mono text-brand-amber">STORESFORGE.COM</span>
                <span class="text-lg font-display font-bold text-white">E-Commerce Growth Engine</span>
              </div>
            </div>
          </div>
        </article>

        <!-- 02 — ShowForm -->
        <article class="gsap-project-card p-8 sm:p-10 md:p-12 rounded-xl bg-surface-ground border border-border-subtle hover:border-content-muted transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group">
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center space-x-3">
              <span class="text-base font-display font-extrabold text-brand-amber">02</span>
              <span class="text-xs font-mono font-semibold tracking-wider text-content-muted uppercase">
                SHOPIFY APP · SAAS · PRODUCT
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-display font-bold text-content-primary tracking-tight">
              Forms, built natively for Shopify.
            </h3>
            <p class="text-base text-content-secondary leading-relaxed">
              A Shopify-native form builder that helps merchants create custom forms, capture qualified leads, and streamline customer communication without code or bloat.
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              {['Shopify Native App', 'React & Node.js', 'Lead Capture Engine', 'GraphQL API', 'Zero-Latency Embed'].map(tag => (
                <span class="px-3 py-1 text-xs font-mono font-medium rounded bg-surface-card border border-border-subtle text-content-primary">
                  {tag}
                </span>
              ))}
            </div>
            <div class="pt-2">
              <a 
                href="https://showform.app" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center text-sm font-display font-bold text-content-primary group-hover:text-brand-amber transition-colors"
              >
                <span>Visit ShowForm</span>
                <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span>
              </a>
            </div>
          </div>
          <div class="lg:col-span-5">
            <div class="aspect-[16/10] rounded-lg overflow-hidden border border-border-subtle bg-surface-dark relative shadow-inner">
              <Image 
                src={project2Image} 
                alt="ShowForm Shopify App" 
                class="w-full h-full object-cover object-top filter grayscale group-hover:grayscale-0 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-6 flex flex-col justify-end">
                <span class="text-xs font-mono text-brand-emerald">SHOWFORM.APP</span>
                <span class="text-lg font-display font-bold text-white">Shopify Form Builder SaaS</span>
              </div>
            </div>
          </div>
        </article>

        <!-- 03 — SpotMetal -->
        <article class="gsap-project-card p-8 sm:p-10 md:p-12 rounded-xl bg-surface-ground border border-border-subtle hover:border-content-muted transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group">
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center space-x-3">
              <span class="text-base font-display font-extrabold text-brand-amber">03</span>
              <span class="text-xs font-mono font-semibold tracking-wider text-content-muted uppercase">
                SHOPIFY APP · AUTOMATION · REAL-TIME DATA
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-display font-bold text-content-primary tracking-tight">
              Real-time precious metal pricing for Shopify.
            </h3>
            <p class="text-base text-content-secondary leading-relaxed">
              A specialized Shopify application that automates spot pricing for gold, silver, platinum, and palladium while dynamically updating product prices and storefront pricing banners with millisecond precision.
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              {['Live Financial Feeds', 'Price Automation Engine', 'Dynamic Banners', 'High Concurrency', 'Metal Spot Calculations'].map(tag => (
                <span class="px-3 py-1 text-xs font-mono font-medium rounded bg-surface-card border border-border-subtle text-content-primary">
                  {tag}
                </span>
              ))}
            </div>
            <div class="pt-2">
              <a 
                href="https://apps.shopify.com/spotmetal-pricing-buyback" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center text-sm font-display font-bold text-content-primary group-hover:text-brand-amber transition-colors"
              >
                <span>View on Shopify App Store</span>
                <span class="ml-1.5 text-xs">↗</span>
              </a>
            </div>
          </div>
          <div class="lg:col-span-5">
            <div class="aspect-[16/10] rounded-lg overflow-hidden border border-border-subtle bg-surface-dark relative shadow-inner">
              <Image 
                src={project3Image} 
                alt="SpotMetal Real-time Pricing Engine" 
                class="w-full h-full object-cover object-top filter grayscale group-hover:grayscale-0 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-6 flex flex-col justify-end">
                <span class="text-xs font-mono text-brand-blue">AUTOMATION ENGINE</span>
                <span class="text-lg font-display font-bold text-white">SpotMetal Pricing App</span>
              </div>
            </div>
          </div>
        </article>

        <!-- 04 — AutoGaragePro -->
        <article class="gsap-project-card p-8 sm:p-10 md:p-12 rounded-xl bg-surface-ground border border-border-subtle hover:border-content-muted transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group">
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center space-x-3">
              <span class="text-base font-display font-extrabold text-brand-amber">04</span>
              <span class="text-xs font-mono font-semibold tracking-wider text-content-muted uppercase">
                SAAS · AUTOMATION · OPERATIONS
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-display font-bold text-content-primary tracking-tight">
              Automating the modern auto workshop.
            </h3>
            <p class="text-base text-content-secondary leading-relaxed">
              A garage management platform designed to help automotive workshops manage customers, jobs, parts inventory, technicians, and end-to-end business workflows.
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              {['Workshop Operations CRM', 'Job Card Management', 'Inventory Tracking', 'Automated Billing', 'Cloud Architecture'].map(tag => (
                <span class="px-3 py-1 text-xs font-mono font-medium rounded bg-surface-card border border-border-subtle text-content-primary">
                  {tag}
                </span>
              ))}
            </div>
            <div class="pt-2">
              <a 
                href="https://autogaragepro.com/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center text-sm font-display font-bold text-content-primary group-hover:text-brand-amber transition-colors"
              >
                <span>Visit AutoGaragePro</span>
                <span class="ml-1.5 text-xs">↗</span>
              </a>
            </div>
          </div>
          <div class="lg:col-span-5">
            <div class="aspect-[16/10] rounded-lg overflow-hidden border border-border-subtle bg-surface-dark relative shadow-inner">
              <Image 
                src={project4Image} 
                alt="AutoGaragePro Management SaaS" 
                class="w-full h-full object-cover object-top filter grayscale group-hover:grayscale-0 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-6 flex flex-col justify-end">
                <span class="text-xs font-mono text-brand-amber">OPERATIONS SAAS</span>
                <span class="text-lg font-display font-bold text-white">AutoGaragePro Platform</span>
              </div>
            </div>
          </div>
        </article>

      </div>

    </div>
  </section>

  <!-- 4. PRODUCTS SECTION ("Products I've Built") -->
  <section id="products" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-surface-ground border-b border-border-subtle scroll-mt-20">
    <div class="max-w-6xl mx-auto">
      
      <div class="gsap-section-header mb-16">
        <span class="text-xs font-mono font-bold tracking-widest text-brand-amber uppercase block mb-3">
          PRODUCTS I'VE BUILT
        </span>
