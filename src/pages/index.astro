---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile-animated.jpg';
import project1Image from '../assets/images/project-1.jpg';
import project2Image from '../assets/images/project-2.jpg';
import project3Image from '../assets/images/project-3.jpg';
import project4Image from '../assets/images/project-4.jpg';
---

<Layout 
  title="Morshadun Nur — Founder, Product Engineer, Shopify & AI Builder"
  description="Building Shopify, SaaS & AI products that help businesses scale. Founder of QbyteSoft & StoresForge. Creator of ShowForm.app."
>

  <!-- 1. HERO SECTION (CLASSY EDITORIAL & HIGH CONVERSION) -->
  <section class="relative pt-32 sm:pt-36 md:pt-40 lg:pt-44 pb-20 md:pb-28 px-4 sm:px-6 lg:px-8 border-b border-border-subtle bg-surface-ground overflow-hidden">
    <!-- Subtle architectural background grid line -->
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>
    
    <!-- Ambient glowing light accents (Brighten Studios aesthetic) -->
    <div class="absolute -top-32 left-1/4 -z-10 w-[500px] h-[500px] bg-brand-amber/10 dark:bg-amber-500/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-20 -z-10 w-[450px] h-[450px] bg-blue-500/5 dark:bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Hero Headline & Copy -->
        <div class="lg:col-span-7 space-y-8">
          <!-- Eyebrow Pill -->
          <div class="hero-eyebrow inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-surface-card border border-border-subtle shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-mono font-semibold tracking-wider text-content-secondary uppercase">
              FOUNDER · PRODUCT ENGINEER · SHOPIFY PLUS
            </span>
          </div>

          <!-- Main Headline -->
          <h1 class="hero-title text-4xl sm:text-5xl lg:text-[52px] xl:text-[56px] font-display font-extrabold text-content-primary tracking-tight leading-[1.12] break-words">
            Building <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-amber via-[#EA580C] to-brand-amber">Shopify, SaaS & AI</span> products that scale.
          </h1>

          <!-- Supporting Copy -->
          <p class="hero-copy text-base sm:text-lg text-content-secondary leading-relaxed max-w-2xl font-sans">
            I’m <strong class="text-content-primary font-semibold">Morshadun Nur (Nur)</strong> — founder of <span class="text-content-primary font-medium">QbyteSoft</span> & <span class="text-content-primary font-medium">StoresForge</span> with 10+ years of engineering experience. I help high-growth e-commerce brands and tech startups turn complex problems into high-converting digital products, custom Shopify systems, and AI automation.
          </p>

          <!-- Action Buttons -->
          <div class="hero-ctas flex flex-wrap items-center gap-4 pt-1">
            <a 
              href="https://www.upwork.com/freelancers/morshadunnur" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-2.5 px-7 py-4 rounded-xl font-display text-sm sm:text-base font-bold text-white bg-gradient-to-r from-brand-amber via-[#EA580C] to-brand-amber hover:from-[#EA580C] hover:to-brand-amber shadow-[0_4px_20px_rgba(217,119,6,0.35)] hover:shadow-[0_6px_25px_rgba(217,119,6,0.5)] active:scale-[0.98] transition-all"
            >
              <span>Start a Project (Upwork)</span>
              <span class="text-xs transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </a>
            <a 
              href="#work" 
              class="inline-flex items-center gap-2 px-6 py-4 rounded-xl font-display text-sm sm:text-base font-semibold text-content-primary bg-surface-card border border-border-muted hover:border-content-primary hover:bg-surface-muted transition-all active:scale-[0.98]"
            >
              <span>Explore Selected Work</span>
              <span class="text-xs text-content-muted">↓</span>
            </a>
          </div>

          <!-- High-Trust Social Proof & Verification Row -->
          <div class="hero-creds pt-5 border-t border-border-subtle/80 flex flex-wrap items-center gap-3 text-xs font-mono">
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-card border border-border-subtle shadow-sm">
              <span class="text-brand-amber">★★★★★</span>
              <span class="font-bold text-content-primary">5.0 Rating</span>
              <span class="text-content-muted">(100% Success)</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-pink-500/10 border border-pink-500/20 text-pink-600 dark:text-pink-400 font-bold">
              <span>★</span> Top Rated Plus
            </div>
            <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-card border border-border-subtle text-content-secondary">
              <span class="font-bold text-content-primary">10+</span> Years Experience
            </div>
          </div>
        </div>

        <!-- Right: Video Client Feedback Card (3D Luxury Glass Card) -->
        <div class="hero-video-card lg:col-span-5">
          <div class="p-5 sm:p-6 rounded-3xl bg-white/95 dark:bg-[#111118]/95 backdrop-blur-2xl border border-black/[0.08] dark:border-white/[0.12] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.12)] dark:shadow-[0_30px_70px_-15px_rgba(0,0,0,0.8)] space-y-4">
            
            <!-- Video Header Badge -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex text-brand-amber text-xs">★★★★★</div>
                <span class="text-[11px] font-mono font-bold tracking-wider text-content-secondary uppercase">
                  VERIFIED CLIENT REVIEW
                </span>
              </div>
              <span class="px-2.5 py-0.5 text-[10px] font-mono font-bold rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                100% SUCCESS
              </span>
            </div>

            <!-- Responsive Video Frame -->
            <div class="aspect-video w-full rounded-2xl overflow-hidden shadow-inner bg-black border border-black/10 dark:border-white/10 relative group">
              <iframe 
                class="w-full h-full"
                src="https://www.youtube-nocookie.com/embed/gF63dOD1K4Y?rel=0" 
                title="Client Video Testimonial for Morshadun Nur" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen
              ></iframe>
            </div>

            <!-- Quote & Upwork Link -->
            <div class="pt-2">
              <p class="text-sm sm:text-[15px] font-display font-bold text-content-primary leading-snug">
                "Delivered beyond expectations — a true technical partner who understands commerce and engineering."
              </p>
              <div class="mt-3 flex items-center justify-between text-xs font-mono pt-3 border-t border-border-subtle">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full bg-brand-amber/20 text-brand-amber flex items-center justify-center font-bold text-[10px]">
                    DJ
                  </div>
                  <span class="text-content-secondary font-medium">Daniel Jayal · E-com Founder</span>
                </div>
                <a 
                  href="https://www.upwork.com/freelancers/morshadunnur" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="font-bold text-[#14A800] hover:underline flex items-center gap-1"
                >
                  Upwork Profile ↗
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. TRUST & CREDIBILITY 4-COLUMN AUTHORITY SLAB -->
  <section class="trust-strip border-b border-border-subtle bg-surface-muted/90 dark:bg-[#0B0B10] py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
      
      <div class="trust-item p-4 sm:p-5 rounded-2xl bg-surface-card/60 dark:bg-white/[0.02] border border-border-subtle hover:border-brand-amber/40 transition-colors space-y-1.5">
        <div class="flex items-center gap-2 text-brand-amber">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-lg sm:text-xl font-display font-extrabold text-content-primary dark:text-white">10+ Years</span>
        </div>
        <p class="text-xs sm:text-sm text-content-secondary font-sans leading-tight">
          Product & Full-Stack Software Engineering
        </p>
      </div>

      <div class="trust-item p-4 sm:p-5 rounded-2xl bg-surface-card/60 dark:bg-white/[0.02] border border-border-subtle hover:border-brand-amber/40 transition-colors space-y-1.5">
        <div class="flex items-center gap-2 text-brand-amber">
          <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
          <span class="text-lg sm:text-xl font-display font-extrabold text-content-primary dark:text-white">Top Rated Plus</span>
        </div>
        <p class="text-xs sm:text-sm text-content-secondary font-sans leading-tight">
          Top 1% Global Shopify Talent on Upwork
        </p>
      </div>

      <div class="trust-item p-4 sm:p-5 rounded-2xl bg-surface-card/60 dark:bg-white/[0.02] border border-border-subtle hover:border-brand-amber/40 transition-colors space-y-1.5">
        <div class="flex items-center gap-2 text-brand-amber">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="text-lg sm:text-xl font-display font-extrabold text-content-primary dark:text-white">50+ Stores</span>
        </div>
        <p class="text-xs sm:text-sm text-content-secondary font-sans leading-tight">
          Shopify Plus, Apps & High-Converting CRO
        </p>
      </div>

      <div class="trust-item p-4 sm:p-5 rounded-2xl bg-surface-card/60 dark:bg-white/[0.02] border border-border-subtle hover:border-brand-amber/40 transition-colors space-y-1.5">
        <div class="flex items-center gap-2 text-brand-amber">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span class="text-lg sm:text-xl font-display font-extrabold text-content-primary dark:text-white">Founder</span>
        </div>
        <p class="text-xs sm:text-sm text-content-secondary font-sans leading-tight">
          StoresForge, QbyteSoft & ShowForm.app
        </p>
      </div>

    </div>
  </section>

  <!-- 4. UPWORK TOP RATED PLUS HIRE ME SECTION -->
  <section class="py-14 md:py-20 px-4 sm:px-6 lg:px-8 bg-surface-muted border-b border-border-subtle">
    <div class="max-w-6xl mx-auto">
      <div class="p-8 sm:p-12 rounded-2xl bg-surface-card border border-border-subtle shadow-sm flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <!-- Left details -->
        <div class="space-y-4 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-pink-50 text-pink-700 border border-pink-200 flex items-center">
              <span class="mr-1">★</span> Top Rated Plus
            </span>
            <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-blue-50 text-blue-700 border border-blue-200">
              100% Job Success
            </span>
            <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-surface-muted text-content-primary border border-border-subtle">
              Verified Shopify Specialist
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-display font-bold text-content-primary tracking-tight">
            Need a Top Rated Plus Shopify & SaaS Engineer?
          </h3>

          <p class="text-sm sm:text-base text-content-secondary leading-relaxed">
            Whether you prefer working directly or contracting securely via Upwork Enterprise/Escrow, I offer flexible engagement models for startups, agencies, and e-commerce brands.
          </p>
        </div>

        <!-- Right CTAs -->
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto flex-shrink-0">
          <a 
            href="https://www.upwork.com/freelancers/morshadunnur" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center px-6 py-3.5 rounded font-display text-sm font-bold text-white bg-[#14A800] hover:bg-[#118f00] transition-all shadow-md group text-center"
          >
            <span>Hire on Upwork</span>
            <span class="ml-1.5 text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
          </a>
          <a 
            href="#contact" 
            class="inline-flex items-center justify-center px-6 py-3.5 rounded font-display text-sm font-semibold text-content-primary bg-surface-muted border border-border-muted hover:border-content-primary transition-all text-center"
          >
            <span>Direct Project Inquiry →</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. SELECTED WORK (FEATURED WORK) -->
  <section id="work" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-surface-card border-b border-border-subtle scroll-mt-20">
    <div class="max-w-6xl mx-auto">
      
      <!-- Section Header -->
      <div class="gsap-section-header mb-16 md:mb-20">
        <span class="text-xs font-mono font-bold tracking-widest text-brand-amber uppercase block mb-3">
          SELECTED WORK
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-content-primary tracking-tight">
          Products and platforms I've built to solve real business problems.
        </h2>
      </div>

      <!-- Project List with Designmonks Sticky Stacking Deck Effect -->
      <div class="relative space-y-12 md:space-y-20">
        
        <!-- 01 — StoresForge (Indigo / Lavender Slab) -->
        <article 
          class="gsap-project-card sticky rounded-3xl p-8 sm:p-10 md:p-12 bg-[#EEF2FF] dark:bg-[#121424] border border-indigo-200/80 dark:border-indigo-500/20 shadow-[0_20px_50px_rgba(0,0,0,0.06)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.6)] transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center group overflow-hidden mb-12"
          style="top: calc(5.5rem + 0 * 1.5rem); z-index: 10;"
        >
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold tracking-widest text-indigo-600 dark:text-indigo-400 uppercase italic">
                Shopify · Agency & Growth
              </span>
            </div>
            
            <h3 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold text-content-primary dark:text-white tracking-tight leading-snug">
              Shopify experiences engineered to convert and scale.
            </h3>
            
            <p class="text-base sm:text-lg text-content-secondary dark:text-zinc-300 leading-relaxed">
              Full-lifecycle Shopify development for ambitious e-commerce brands — from high-converting custom storefronts and Shopify Plus architecture to private apps, checkout extensions, and automated workflows.
            </p>

            <!-- Metrics Row (Designmonks style) -->
            <div class="grid grid-cols-2 gap-6 pt-2 pb-2 border-y border-indigo-200/60 dark:border-indigo-500/20">
              <div>
                <span class="block text-2xl sm:text-3xl font-display font-extrabold text-content-primary dark:text-white">50+</span>
                <span class="text-xs font-mono text-content-muted dark:text-zinc-400">Stores & Apps Built</span>
              </div>
              <div>
                <span class="block text-2xl sm:text-3xl font-display font-extrabold text-indigo-600 dark:text-indigo-400">+38%</span>
                <span class="text-xs font-mono text-content-muted dark:text-zinc-400">Avg. Conversion Lift</span>
              </div>
            </div>

            <!-- Founder Action Badge (Designmonks Endorsement style) -->
            <div class="pt-2 flex items-center justify-between">
              <a 
                href="https://storesforge.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-3 p-2 pr-5 rounded-full bg-white/90 dark:bg-[#1A1C30] border border-indigo-200 dark:border-indigo-500/30 text-content-primary dark:text-white hover:border-indigo-500 dark:hover:border-indigo-400 transition-all shadow-sm group/btn"
              >
                <div class="w-9 h-9 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-mono font-bold">
                  SF
                </div>
                <span class="text-xs sm:text-sm font-display font-bold">Explore storesforge.com</span>
                <span class="text-xs text-indigo-600 dark:text-indigo-400 transition-transform group-hover/btn:translate-x-1">↗</span>
              </a>
            </div>
          </div>

          <!-- Right Mockup Device -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="w-full aspect-[16/11] rounded-2xl overflow-hidden bg-gradient-to-br from-indigo-500/20 via-indigo-600/10 to-indigo-900/40 p-4 border border-indigo-300/40 dark:border-indigo-500/30 shadow-xl group-hover:scale-[1.02] transition-transform duration-500">
              <div class="w-full h-full rounded-xl overflow-hidden shadow-2xl relative">
                <Image 
                  src={project1Image} 
                  alt="StoresForge Shopify E-commerce Platform" 
                  class="w-full h-full object-cover object-top"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-5 flex flex-col justify-end">
                  <span class="text-xs font-mono text-indigo-300">STORESFORGE</span>
                  <span class="text-base font-display font-bold text-white">E-Commerce Growth Engine</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- 02 — ShowForm (Mint / Emerald Slab) -->
        <article 
          class="gsap-project-card sticky rounded-3xl p-8 sm:p-10 md:p-12 bg-[#ECFDF5] dark:bg-[#0D1914] border border-emerald-200/80 dark:border-emerald-500/20 shadow-[0_20px_50px_rgba(0,0,0,0.06)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.6)] transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center group overflow-hidden mb-12"
          style="top: calc(5.5rem + 1 * 1.5rem); z-index: 11;"
        >
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold tracking-widest text-emerald-600 dark:text-emerald-400 uppercase italic">
                Shopify App · SaaS Platform
              </span>
            </div>
            
            <h3 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold text-content-primary dark:text-white tracking-tight leading-snug">
              Forms and lead capture, built natively for Shopify.
            </h3>
            
            <p class="text-base sm:text-lg text-content-secondary dark:text-zinc-300 leading-relaxed">
              A zero-code Shopify-native form builder enabling merchants to create custom forms, capture targeted leads, and streamline customer communication without slowing down page load times.
            </p>

            <!-- Metrics Row -->
            <div class="grid grid-cols-2 gap-6 pt-2 pb-2 border-y border-emerald-200/60 dark:border-emerald-500/20">
              <div>
                <span class="block text-2xl sm:text-3xl font-display font-extrabold text-content-primary dark:text-white">0ms</span>
                <span class="text-xs font-mono text-content-muted dark:text-zinc-400">Zero-Latency Embed</span>
              </div>
              <div>
                <span class="block text-2xl sm:text-3xl font-display font-extrabold text-emerald-600 dark:text-emerald-400">100%</span>
                <span class="text-xs font-mono text-content-muted dark:text-zinc-400">Shopify Native</span>
              </div>
            </div>

            <!-- Founder Action Badge -->
            <div class="pt-2 flex items-center justify-between">
              <a 
                href="https://showform.app" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-3 p-2 pr-5 rounded-full bg-white/90 dark:bg-[#12221C] border border-emerald-200 dark:border-emerald-500/30 text-content-primary dark:text-white hover:border-emerald-500 dark:hover:border-emerald-400 transition-all shadow-sm group/btn"
              >
                <div class="w-9 h-9 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-mono font-bold">
                  SF
                </div>
                <span class="text-xs sm:text-sm font-display font-bold">Visit showform.app</span>
                <span class="text-xs text-emerald-600 dark:text-emerald-400 transition-transform group-hover/btn:translate-x-1">↗</span>
              </a>
            </div>
          </div>

          <!-- Right Mockup Device -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="w-full aspect-[16/11] rounded-2xl overflow-hidden bg-gradient-to-br from-emerald-500/20 via-emerald-600/10 to-emerald-900/40 p-4 border border-emerald-300/40 dark:border-emerald-500/30 shadow-xl group-hover:scale-[1.02] transition-transform duration-500">
              <div class="w-full h-full rounded-xl overflow-hidden shadow-2xl relative">
                <Image 
                  src={project2Image} 
                  alt="ShowForm Shopify App" 
                  class="w-full h-full object-cover object-top"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-5 flex flex-col justify-end">
                  <span class="text-xs font-mono text-emerald-300">SHOWFORM.APP</span>
                  <span class="text-base font-display font-bold text-white">Shopify Form Builder SaaS</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- 03 — SpotMetal (Warm Coral / Amber Slab) -->
        <article 
          class="gsap-project-card sticky rounded-3xl p-8 sm:p-10 md:p-12 bg-[#FFF7ED] dark:bg-[#1E1510] border border-amber-200/80 dark:border-amber-500/20 shadow-[0_20px_50px_rgba(0,0,0,0.06)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.6)] transition-all grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center group overflow-hidden mb-12"
          style="top: calc(5.5rem + 2 * 1.5rem); z-index: 12;"
        >
